{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "shared-ui-lib": {
      "projectType": "library",
      "root": "projects/shared-ui-lib",
      "sourceRoot": "projects/shared-ui-lib/src",
      "prefix": "ui",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/shared-ui-lib/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/shared-ui-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared-ui-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/shared-ui-lib/src/test.ts",
            "tsConfig": "projects/shared-ui-lib/tsconfig.spec.json",
            "karmaConfig": "projects/shared-ui-lib/karma.conf.js"
          }
        }
      }
    },
    "core-lib": {
      "projectType": "library",
      "root": "projects/core-lib",
      "sourceRoot": "projects/core-lib/src",
      "prefix": "core",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/core-lib/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/core-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/core-lib/src/test.ts",
            "tsConfig": "projects/core-lib/tsconfig.spec.json",
            "karmaConfig": "projects/core-lib/karma.conf.js"
          }
        }
      }
    },
    "ofs": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/ofs",
      "sourceRoot": "projects/ofs/src",
      "prefix": "ofs",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/ofs",
            "index": "projects/ofs/src/index.html",
            "main": "projects/ofs/src/main.ts",
            "polyfills": "projects/ofs/src/polyfills.ts",
            "tsConfig": "projects/ofs/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/ofs/src/favicon.ico",
              "projects/ofs/src/assets"
            ],
            "styles": ["projects/ofs/src/styles.scss"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/ofs/src/environments/environment.ts",
                  "with": "projects/ofs/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "ofs:build:production"
            },
            "development": {
              "browserTarget": "ofs:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "ofs:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/ofs/src/test.ts",
            "polyfills": "projects/ofs/src/polyfills.ts",
            "tsConfig": "projects/ofs/tsconfig.spec.json",
            "karmaConfig": "projects/ofs/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/ofs/src/favicon.ico",
              "projects/ofs/src/assets"
            ],
            "styles": ["projects/ofs/src/styles.scss"],
            "scripts": []
          }
        }
      }
    },
    "mpa-website": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/mpa-website",
      "sourceRoot": "projects/mpa-website/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/mpa-website",
            "index": "projects/mpa-website/src/index.html",
            "main": "projects/mpa-website/src/main.ts",
            "polyfills": "projects/mpa-website/src/polyfills.ts",
            "tsConfig": "projects/mpa-website/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["projects/mpa-website/src/assets"],
            "styles": [
              "projects/mpa-website/src/styles.scss",
              "node_modules/material-design-icons/iconfont/material-icons.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/mpa-website/src/environments/environment.ts",
                  "with": "projects/mpa-website/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "mpa-website:build:production"
            },
            "development": {
              "browserTarget": "mpa-website:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "mpa-website:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/mpa-website/src/test.ts",
            "polyfills": "projects/mpa-website/src/polyfills.ts",
            "tsConfig": "projects/mpa-website/tsconfig.spec.json",
            "karmaConfig": "projects/mpa-website/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/mpa-website/src/favicon.ico",
              "projects/mpa-website/src/assets"
            ],
            "styles": ["projects/mpa-website/src/styles.scss"],
            "scripts": []
          }
        }
      }
    }
  }
}
